# 忽略编译和构建目录
target/
usr/
node_modules/
out/
gen/
dist/
avatar/

# 忽略特定格式的文件
uploads/
audio/
vosk-model*
*.zip
*.log
*.tmp
*.swp
*.swo
.vite
nohup.out

# 忽略运行日志目录
logs/

# 忽略数据库本地导出文件（防止测试数据污染仓库）
*.dump
*.bak
*.sqlite
*.db
*.sql.gz

# 忽略操作系统文件
.DS_Store
Thumbs.db
desktop.ini

# 忽略 IDE 相关文件
.idea/
*.iml
*.ipr
*.iws

# 忽略 Maven 和 Gradle 缓存
.mvn/
.mvn/wrapper/
.gradle/

# 忽略本地配置文件
application-local.properties
src/main/resources/application-local.yml
src/main/resources/application-*.local.yml
src/main/resources/application-private.yml
src/main/resources/application-secrets.yml
web/.env.local
web/.env.*.local
.env.local
.env.*.local

.vscode/
datasets/
.cursorrules
.cursor/
